{
  "info": {
    "_postman_id": "renta-facil-collection-001",
    "name": "RentaFacil API",
    "schema": "https://schema.getpostman.com/json/collection/v2.1.0/collection.json",
    "description": "Colección de pruebas para los endpoints principales de RentaFacil: vehículos, reservas y clientes."
  },
  "item": [
    {
      "name": "Vehicles",
      "item": [
        {
          "name": "Registrar vehículo (Admin)",
          "request": {
            "method": "POST",
            "header": [
              { "key": "Authorization", "value": "Bearer {{token}}", "type": "text" }
            ],
            "body": {
              "mode": "formdata",
              "formdata": [
                { "key": "LicensePlate", "value": "ABC123", "type": "text" },
                { "key": "Brand", "value": "Toyota", "type": "text" },
                { "key": "Model", "value": "Corolla", "type": "text" },
                { "key": "Type", "value": "Sedan", "type": "text" },
                { "key": "IsAvailable", "value": "true", "type": "text" },
                { "key": "imageFile", "type": "file" }
              ]
            },
            "url": {
              "raw": "http://localhost:5277/api/vehicles",
              "protocol": "http",
              "host": ["localhost"],
              "port": "5277",
              "path": ["api", "vehicles"]
            }
          }
        },
        {
          "name": "Listar todos los vehículos",
          "request": {
            "method": "GET",
            "url": {
              "raw": "http://localhost:5277/api/vehicles",
              "protocol": "http",
              "host": ["localhost"],
              "port": "5277",
              "path": ["api", "vehicles"]
            }
          }
        },
        {
          "name": "Consultar vehículos disponibles",
          "request": {
            "method": "GET",
            "url": {
              "raw": "http://localhost:5277/api/vehicles/available?type=Sedan&startDate=2025-07-21&endDate=2025-07-25",
              "protocol": "http",
              "host": ["localhost"],
              "port": "5277",
              "path": ["api", "vehicles", "available"],
              "query": [
                { "key": "type", "value": "Sedan" },
                { "key": "startDate", "value": "2025-07-21" },
                { "key": "endDate", "value": "2025-07-25" }
              ]
            }
          }
        },
        {
          "name": "Actualizar vehículo (Admin)",
          "request": {
            "method": "PUT",
            "header": [
              { "key": "Authorization", "value": "Bearer {{token}}", "type": "text" },
              { "key": "Content-Type", "value": "application/json", "type": "text" }
            ],
            "body": {
              "mode": "raw",
              "raw": "{\n  \"licensePlate\": \"ABC123\",\n  \"brand\": \"Toyota\",\n  \"model\": \"Corolla\",\n  \"type\": \"Sedan\",\n  \"isAvailable\": true,\n  \"image\": \"url-imagen.png\"\n}"
            },
            "url": {
              "raw": "http://localhost:5277/api/vehicles/1",
              "protocol": "http",
              "host": ["localhost"],
              "port": "5277",
              "path": ["api", "vehicles", "1"]
            }
          }
        },
        {
          "name": "Eliminar vehículo (Admin)",
          "request": {
            "method": "DELETE",
            "header": [
              { "key": "Authorization", "value": "Bearer {{token}}", "type": "text" }
            ],
            "url": {
              "raw": "http://localhost:5277/api/vehicles/1",
              "protocol": "http",
              "host": ["localhost"],
              "port": "5277",
              "path": ["api", "vehicles", "1"]
            }
          }
        }
      ]
    },
    {
